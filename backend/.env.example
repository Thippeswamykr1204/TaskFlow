# Runtime environment: development | test | production
NODE_ENV=development

# Port the Nest HTTP server listens on
PORT=3000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Secret used to sign short-lived access tokens (min 16 chars)
JWT_ACCESS_SECRET=

# Secret used to sign long-lived refresh tokens (min 16 chars, must differ from access secret)
JWT_REFRESH_SECRET=

# Allowed origin for CORS (the frontend's URL)
CORS_ORIGIN=http://localhost:3001

# Cloudinary cloud name (from your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key
CLOUDINARY_API_KEY=

# Cloudinary API secret
CLOUDINARY_API_SECRET=

# Max allowed attachment upload size in megabytes (defaults to 10 if unset)
MAX_ATTACHMENT_SIZE_MB=10

# Resend API key (from your Resend dashboard)
RESEND_API_KEY=

# "From" address for task notification emails, e.g. "TaskFlow <notifications@yourdomain.com>" —
# must be a domain verified in Resend; for local dev use Resend's sandbox sender
# (onboarding@resend.dev) since it works without domain verification
EMAIL_FROM_ADDRESS=