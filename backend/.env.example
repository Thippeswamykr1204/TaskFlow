# Runtime environment: development | test | production
NODE_ENV=development

# Port the Nest HTTP server listens on
PORT=3000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Secret used to sign short-lived access tokens (min 16 chars)
JWT_ACCESS_SECRET=

# Secret used to sign long-lived refresh tokens (min 16 chars, must differ from access secret)
JWT_REFRESH_SECRET=

# Allowed origin for CORS (the frontend's URL)
CORS_ORIGIN=http://localhost:3001
